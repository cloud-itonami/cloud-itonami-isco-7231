(ns auto-repair.governor
  "AutoRepairGovernor — the independent safety/traceability layer for the
  ISCO-08 7231 independent auto-repair actor. The Repair Advisor proposes
  actions (repair-action, invoice); it has no notion of order provenance
  or engine-running risk, so this MUST be a separate system able to
  *reject* a proposal and fall back to HOLD — the itonami-actor pattern
  (independent Governor gates a proposing actor) applied to this
  occupation.

  Charter (mirrors ADR-2607011000 robotics premise + ADR-2607012000
  cloud-itonami-isco): the actor never dispatches a robot action or writes an
  operating record the governor refuses. A repair action performed with the
  engine running ALWAYS requires human sign-off — it can never be
  auto-approved.

  HARD invariants for :auto-repair/propose:
    1. Order provenance     — a repair-action or invoice must reference a
       registered order on a registered vehicle.
    2. No-actuation         — the proposal must not directly mutate a
       repair-action or invoice record outside the record-repair-action!/
       record-invoice! path (effect must be :propose, never a raw store
       write).
    3. Engine-running safety — a repair-action of kind `:engine-running`
       always requires :high or higher safety-class, forcing human
       sign-off; it is never auto-approved regardless of confidence.
    4. Tire-inflation safety — a `:tire-inflation` action must name the
       restraint (safety cage) it runs inside, and its target pressure must
       not exceed the tire's specified pressure (労働安全衛生規則 第328条の2,
       quoted in `auto-repair.facts/tire-inflation`).
  SOFT:
    5. Confidence floor → escalate."
  (:require [auto-repair.facts :as facts]
            [auto-repair.store :as store]))

(def confidence-floor 0.6)
(def safety-classes [:none :low :medium :high :safety-critical])

(defn- safety-rank [safety-class]
  (let [idx (.indexOf safety-classes safety-class)]
    (if (neg? idx) 0 idx)))

(defn- pressure-within-spec? [{:keys [target-pressure-kpa spec-pressure-kpa]}]
  (and (number? target-pressure-kpa) (number? spec-pressure-kpa)
       (pos? spec-pressure-kpa)
       (<= target-pressure-kpa spec-pressure-kpa)))

(defn- hard-violations [{:keys [order-fn]} proposal]
  (let [{:keys [kind order-id safety-class effect restraint]} proposal
        found-order (order-fn order-id)
        inflation?  (= kind (:kind facts/tire-inflation))]
    (cond-> []
      (nil? found-order)
      (conj {:rule :no-order :detail (str "未登録 repair-order " order-id)})

      (not= :propose effect)
      (conj {:rule :no-actuation :detail "effect は :propose のみ許可（直接書込禁止）"})

      (and (= kind :engine-running)
           (< (safety-rank (or safety-class :none)) (safety-rank :high)))
      (conj {:rule :engine-running-safety
             :detail ":engine-running repair は :high 以上の safety-class が必須"})

      (and inflation? (nil? restraint))
      (conj {:rule :tire-inflation-restraint
             :detail "タイヤの空気充てんは安全囲い等の中でのみ（安衛則 第328条の2）"
             :source (:source-url facts/tire-inflation)})

      (and inflation? (not (pressure-within-spec? proposal)))
      (conj {:rule :tire-inflation-pressure
             :detail "充てん圧はタイヤの指定空気圧以下で明示すること（安衛則 第328条の2）"
             :source (:source-url facts/tire-inflation)}))))

(defn assess
  "Assess a proposal against `env` (a map with `:order-fn` lookup,
  decoupled from any concrete Store so this stays pure). Returns
  `{:decision :proceed|:hold|:human-approval :violations [...] :confidence n}`."
  [env proposal]
  (let [violations (hard-violations env proposal)
        safety-class (or (:safety-class proposal) :none)
        confidence (or (:confidence proposal) 0.0)]
    (cond
      (seq violations)
      {:decision :hold :violations violations :confidence confidence}

      (>= (safety-rank safety-class) (safety-rank :high))
      {:decision :human-approval :violations [] :confidence confidence}

      (< confidence confidence-floor)
      {:decision :human-approval :violations [] :confidence confidence
       :reason :low-confidence}

      :else
      {:decision :proceed :violations [] :confidence confidence})))

(defn env-for-store
  "Build the decoupled env map `assess` needs from a concrete
  `auto-repair.store/Store` implementation."
  [store]
  {:order-fn #(store/repair-order store %)})
